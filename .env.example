# =============================================================================
# Al Baraka Bank Assistant + RAGLab — Unified Monorepo Docker Configuration
# =============================================================================
# Optional file: `docker compose up --build` works out of the box WITHOUT
# copying this file. Copy to `.env` only when customizing ports or production
# secrets:
#   cp .env.example .env
#
# LLM / Embedding API keys (NVIDIA_API_KEY, XKIRO_API_KEY, custom *_API_KEY)
# can be entered directly from the web UI after launch at:
#   http://localhost:8080/admin/raglab/settings?tab=keys
# and are persisted automatically to `RAGLab/raglab/.env`.
# =============================================================================

# --- Host ports --------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8081
RAGLAB_PORT=8000
POSTGRES_PORT=5433

# --- PostgreSQL (pgvector) ---------------------------------------------------
POSTGRES_DB=banque_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Internal Backend <-> RAGLab service link (automatic in Docker) ----------
# Inside the Docker network `albaraka-net`, `backend` reaches `raglab` directly
# at `http://raglab:8000` using the shared X-Service-Token below — no manual URL
# configuration in the UI is needed.
RAGLAB_URL=http://raglab:8000
RAGLAB_SERVICE_TOKEN=albaraka-internal-raglab-token
RAGLAB_ALLOW_PROFILE_SWITCH=1

# --- Spring Boot Backend -----------------------------------------------------
# Base64-encoded >=256-bit HS256 signing key. Generate a fresh one in prod:
#   openssl rand -base64 48
JWT_SECRET=YWxiYXJha2EtZGV2LW9ubHktand0LXNlY3JldC1jaGFuZ2UtbWUtaW4tcHJvZC0yNTY=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Seeds local demo accounts (`admin@albaraka.tn` / `postgres`,
# `client@albaraka.tn` / `client123`). Set `DEV_SEED=false` in production.
DEV_SEED=true
JPA_DDL_AUTO=validate
METRICS_PUBLIC=true
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200

# --- Rate limits & chat retention --------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_UPLOAD_MAX=20
CHAT_HISTORY_RETENTION_DAYS=0
CHAT_HISTORY_BACKFILL_ENABLED=false
CHAT_HISTORY_BACKFILL_DRY_RUN=true

# --- Optional image registry tags --------------------------------------------
REGISTRY=albaraka/
TAG=local
GIT_SHA=local
GIT_BRANCH=local
