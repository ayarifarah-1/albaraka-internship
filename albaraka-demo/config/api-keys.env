# =============================================================================
# Al Baraka RAGLab — API Keys Configuration
# =============================================================================
# Paste your provider keys below BEFORE running `docker compose up -d`, OR
# leave them blank and enter/edit them directly from the web interface at:
#   http://localhost:8080/admin/raglab/settings?tab=keys
# Any changes saved in the web UI are automatically written back to this file.
# =============================================================================

# NVIDIA NIM Embeddings (`nvidia/nemotron-3-embed-1b`)
NVIDIA_API_KEY=

# xKiro LLM Answer Generation (`qwen/qwen3.8-max:free`)
XKIRO_API_KEY=

# Optional additional providers (uncomment if needed)
# JINA_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Grounded synthesis settings
ANSWER_SUFFICIENCY_COMMITMENT=0
