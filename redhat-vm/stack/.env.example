# =============================================================================
# Al Baraka Red Hat Appliance — Stack Environment (/opt/albaraka/.env)
# =============================================================================
# Note: CORS_ALLOWED_ORIGINS is automatically updated on boot / DHCP renewal
# by `/usr/local/bin/albaraka-boot-sync.sh` to include the VM's active IP(s).

REGISTRY=elayarifarah
TAG=latest
FRONTEND_PORT=8080
POSTGRES_DB=banque_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RAGLAB_SERVICE_TOKEN=albaraka-internal-raglab-token
DEV_SEED=true
CUSTOMER_CONTEXT_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200
