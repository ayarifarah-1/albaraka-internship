# =============================================================================
# Al Baraka RAGLab — API Keys Configuration (/opt/albaraka/config/api-keys.env)
# =============================================================================
# Configure keys either:
#   1. From your browser: http://<VM-IP>:8080/admin/raglab/settings?tab=keys
#   2. From VM terminal:  sudo albaraka-ctl set-keys
# =============================================================================

# NVIDIA NIM Embeddings (`nvidia/nemotron-3-embed-1b`)
NVIDIA_API_KEY=

# xKiro LLM Answer Generation (`qwen/qwen3.8-max:free`)
XKIRO_API_KEY=

# Optional additional providers
# JINA_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Grounded synthesis settings
ANSWER_SUFFICIENCY_COMMITMENT=0
